# MCU class and specific type
MCU STM32H7xx STM32H753xx

# crystal frequency
OSCILLATOR_HZ 16000000

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_LECTRON_V6X

FLASH_RESERVE_START_KB   0
FLASH_BOOTLOADER_LOAD_KB 128
FLASH_SIZE_KB            2048

# ChibiOS system timer
STM32_ST_USE_TIMER 2

SERIAL_ORDER OTG1 UART7 UART5 USART3

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9  VBUS INPUT OPENDRAIN

# pins for SWD debugging
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# telem1
PE8 UART7_TX UART7
PF6 UART7_RX UART7

# telem2
PC12 UART5_TX UART5
PD2  UART5_RX UART5

# debug uart
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# CS pins
PI9  IMU1_CS     CS
PH5  IMU2_CS     CS
PI4  BMI088_A_CS CS
PI8  BMI088_G_CS CS
PH15 SP4_CS1     CS
PG7  FRAM_CS     CS
PI10 EXT1_CS1    CS
PA15 EXT1_CS2    CS

# armed indication
PE6 nARMED OUTPUT HIGH

# start peripheral power on
PG10 nVDD_5V_HIPOWER_EN OUTPUT LOW
PG4  nVDD_5V_PERIPH_EN  OUTPUT LOW

# LEDs
PE3 LED_ACTIVITY   OUTPUT OPENDRAIN HIGH  # Red
PE5 LED_BOOTLOADER OUTPUT OPENDRAIN HIGH  # Blue
define HAL_LED_ON 0

define HAL_USE_EMPTY_STORAGE 1
define HAL_STORAGE_SIZE 16384

DMA_PRIORITY UART* USART*
