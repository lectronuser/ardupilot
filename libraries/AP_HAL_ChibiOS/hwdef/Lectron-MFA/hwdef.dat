# default to all pins low to avoid ESD issues
DEFAULTGPIO OUTPUT LOW PULLDOWN

MCU STM32H7xx STM32H753xx
OSCILLATOR_HZ 16000000

FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128

APJ_BOARD_ID AP_HW_LECTRON_MFA

# ChibiOS system timer
STM32_ST_USE_TIMER 2

# to be compatible with the px4 bootloader we need
# to use a different RAM_MAP
env USE_ALT_RAM_MAP 1

SERIAL_ORDER OTG1 UART7 USART2 USART1 UART4 UART5 
I2C_ORDER I2C1 I2C4

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9  VBUS INPUT OPENDRAIN

# pins for SWD debugging
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Telem1 
PE8  UART7_TX UART7
PF6  UART7_RX UART7
PF8  UART7_RTS UART7
PE10 UART7_CTS UART7

# GPS1
PB6  USART1_TX USART1
PB7  USART1_RX USART1

# Telem3
PD5  USART2_TX USART2
PA3  USART2_RX USART2
PD4  USART2_RTS USART2
PD3  USART2_CTS USART2

# External (uart4)
PH13 UART4_TX UART4
PH14 UART4_RX UART4

# SBUS RC
PD2 UART5_RX UART5
PC12 UART5_TX UART5
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_RCIN

define HAL_WITH_IO_MCU 0

# SPI2 -> ICM-42670-P
PI2 SPI2_MISO SPI2
PI3 SPI2_MOSI SPI2
PI1 SPI2_SCK  SPI2
PH5 IMU2_CS   CS
PA10 DRDY_ICM42670 INPUT

# SPI3 -> BMI270
PC11 SPI3_MISO SPI3
PB2 SPI3_MOSI SPI3
PC10 SPI3_SCK  SPI3

PI4 IMU3_CS   CS
PI6 DRDY1_BMI270 INPUT
PI7 DRDY2_BMI270 INPUT

# I2C1 -> GPS+MAG
PB8  I2C1_SCL I2C1
PB9  I2C1_SDA I2C1

PF14 I2C4_SCL I2C4
PF15 I2C4_SDA I2C4

define HAL_I2C_INTERNAL_MASK 2

SPIDEV icm42670_2 SPI2 DEVID1 IMU2_CS MODE3 2*MHZ 8*MHZ
SPIDEV bmi270     SPI3 DEVID1 IMU3_CS MODE3 1*MHZ 4*MHZ

IMU Invensensev3 SPI:icm42670_2 ROTATION_ROLL_180_YAW_270
IMU BMI270       SPI:bmi270     ROTATION_PITCH_180

BARO BMP388 I2C:1:0x77

COMPASS BMM350 I2C:1:0x14 false ROTATION_NONE
define HAL_PROBE_EXTERNAL_I2C_COMPASSES

# PWM output pins
PI0  TIM5_CH4  TIM5  PWM(1) GPIO(50)
PH12 TIM5_CH3  TIM5  PWM(2) GPIO(51)
PH11 TIM5_CH2  TIM5  PWM(3) GPIO(52)
PH10 TIM5_CH1  TIM5  PWM(4) GPIO(53)
PB5  TIM3_CH2  TIM3  PWM(5) GPIO(54) 

PF9  TIM14_CH1 TIM14 PWM(6) GPIO(55) NODMA

# heater
PB10 HEATER_EN OUTPUT LOW GPIO(80)

define HAL_HEATER_GPIO_PIN 80
define HAL_HAVE_IMU_HEATER 1
define HAL_IMU_TEMP_DEFAULT 45
define HAL_IMUHEAT_P_DEFAULT 50
define HAL_IMUHEAT_I_DEFAULT 0.07

# ADC
PA0  SCALED_VDD_3V3_S1  ADC1 SCALE(2)
PA4  SCALED_VDD_3V3_S2  ADC1 SCALE(2)
PB0  SCALED_VDD_3V3_S3  ADC1 SCALE(2)
PF12 SCALED_VDD_3V3_S4  ADC1 SCALE(2)

# PB1: no VDD_5V_SENS circuit - define as  
# GPIO to prevent ADC auto-assignment
PB1 UNUSED_PB1 OUTPUT LOW
PC2 ADC_6V6 ADC1 SCALE(2) 

# power enable pins
PC13 VDD_3V3_SD_CARD_EN OUTPUT HIGH
PI11 VDD_3V3_SENSORS1_EN OUTPUT HIGH
PF4  VDD_3V3_SENSORS2_EN OUTPUT HIGH
PE7  VDD_3V3_SENSORS3_EN OUTPUT HIGH
PG8  VDD_3V3_SENSORS4_EN OUTPUT HIGH

# start peripheral power on
PG10 nVDD_5V_HIPOWER_EN OUTPUT LOW
PG4  nVDD_5V_PERIPH_EN  OUTPUT LOW   # LOW -> enabled

# power sensing
PE15 VDD_5V_PERIPH_nOC INPUT PULLUP
PF13 VDD_5V_HIPOWER_nOC INPUT PULLUP

PG1 VDD_BRICK_nVALID INPUT PULLUP
PG2 VDD_BRICK2_nVALID INPUT PULLUP
PG3 VDD_BRICK3_nVALID INPUT PULLUP

# microSD support
PD6  SDMMC2_CK   SDMMC2
PD7  SDMMC2_CMD  SDMMC2
PB14 SDMMC2_D0   SDMMC2
PB15 SDMMC2_D1   SDMMC2
PG11 SDMMC2_D2   SDMMC2
PB4  SDMMC2_D3   SDMMC2
define FATFS_HAL_DEVICE SDCD2

# safety
PD10 LED_SAFETY OUTPUT
PF5 SAFETY_IN INPUT PULLDOWN

define HAL_INS_HIGHRES_SAMPLE 3
define HAL_DEFAULT_INS_FAST_SAMPLE 7

define HAL_STORAGE_SIZE 16384

# allow to have have a dedicated safety switch pin
define HAL_HAVE_SAFETY_SWITCH 1

DMA_PRIORITY SPI2* SPI3* TIM3* TIM5* SDMMC*

# enable FAT filesystem support (needs a microSD defined via SDMMC)
define HAL_OS_FATFS_IO 1

define AP_BOOTLOADER_FLASHING_ENABLED 0
env BUILD_ABIN True
