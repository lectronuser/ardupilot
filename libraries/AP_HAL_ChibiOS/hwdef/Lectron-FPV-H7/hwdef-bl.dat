MCU STM32H7xx STM32H743xx
OSCILLATOR_HZ 16000000

APJ_BOARD_ID AP_HW_LECTRON_FPV_H7

FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

STM32_ST_USE_TIMER 2

DEFAULTGPIO OUTPUT LOW PULLDOWN

SERIAL_ORDER OTG1 

# USB - USB-C connector
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9  VBUS INPUT OPENDRAIN

# pins for SWD debugging
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# LEDs
PD10 LED_ACTIVITY OUTPUT OPENDRAIN HIGH 
PD11 LED_BOOTLOADER OUTPUT OPENDRAIN HIGH 
define HAL_LED_ON 0

define HAL_USE_EMPTY_STORAGE 1
define HAL_STORAGE_SIZE 16384
